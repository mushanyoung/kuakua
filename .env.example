# kuakua deployment settings. The deployed copy is .env.production (mode 600, never committed);
# `bun run doctor` checks it and `bun run config set KEY VALUE` edits it. Generated from
# src/server/settings.ts by `bun run config example` — edit that file, not this one.

# ---- Site
# The site's public https address (no trailing slash). The Worker is attached to this hostname as
# a Custom Domain; its zone must be in the Cloudflare account. [required]
PUBLIC_URL=https://kudos.example.com
# IANA time zone; the monthly Peer Bonus allowance resets at midnight on the 1st here.
APP_TIMEZONE=Asia/Shanghai

# ---- Who can sign in
# Comma-separated admins: directory sync, Peer Bonus report, leaderboard, people page, deleting
# any post. Always allowed to sign in. [required]
ADMIN_EMAILS=you@example.com
# Comma-separated email domains whose people may sign in even if they're not in the directory.
# Leave empty to admit only the directory (and admins). E.g. example.com.
ALLOWED_EMAIL_DOMAINS=
# Cloudflare Zero Trust team domain. Written by scripts/cloudflare-setup.sh. [required, set by
# scripts/cloudflare-setup.sh]
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# AUD tag of the Cloudflare Access application. Written by scripts/cloudflare-setup.sh. [required,
# set by scripts/cloudflare-setup.sh]
CF_ACCESS_AUD=
# Local development only: sign everyone in as this email when there's no Cloudflare Access token.
# DEV_AUTH_EMAIL=you@example.com

# ---- People directory
# Where the people list comes from: "roster" (a CSV/JSON file, ROSTER_FILE) or "lark" (Lark
# contact sync). Empty = lark when LARK_APP_ID is set, else roster. E.g. roster.
DIRECTORY_SOURCE=
# Roster for DIRECTORY_SOURCE=roster:
# email,name,en_name,department,department_en,title,manager,avatar (see
# deploy/roster.example.csv). Avatar paths are relative to the file. scripts/deploy.sh uploads it
# with its avatars; the site picks up a changed roster within a minute.
ROSTER_FILE=./local/roster.csv
# When the daily directory sync runs, as a cron expression in UTC (default 19:00 UTC = 03:00 in
# China). Lark avatars are only downloaded when they changed.
SYNC_CRON=0 19 * * *

# ---- Lark / Feishu (DIRECTORY_SOURCE=lark)
# Lark/Feishu self-built app ID, for DIRECTORY_SOURCE=lark (directory sync and notifications).
# README lists the scopes it needs. [required when it applies]
LARK_APP_ID=
# Lark/Feishu app secret (stored as a Worker secret). [required when it applies, secret]
LARK_APP_SECRET=
# https://open.larksuite.com for Lark, https://open.feishu.cn for Feishu.
LARK_BASE_URL=https://open.larksuite.com
# 1 = DM recipients, CC'd people and the sender on Lark (needs im:message:send_as_bot and the bot
# capability). 0 = off.
LARK_NOTIFY=1
# Optional Lark group chat ID that also gets every public thanks.
LARK_BROADCAST_CHAT_ID=

# ---- Thanks & Peer Bonus
# Optional JSON list of the values a thanks can be tagged with (see deploy/values.example.json);
# scripts/deploy.sh passes it to the Worker. Empty = the built-in eight. E.g. ./local/values.json.
VALUES_FILE=
# Peer Bonus points each person can give per month.
BONUS_MONTHLY_ALLOWANCE=10
# Points each recipient gets per Peer Bonus.
BONUS_POINTS=1

# ---- Cloudflare
# Name of the Worker; the D1 database and R2 bucket are named after it. Use a different one per
# deployment in the same Cloudflare account.
WORKER_NAME=kuakua
# Where scripts/cloudflare-setup.sh creates the D1 database and R2 bucket: wnam, enam, weur, eeur,
# apac or oc (apac for users in Asia). Empty = near whoever runs the script. Only applies when
# they're first created. E.g. apac.
DATA_LOCATION=
# ID of the D1 database. Written by scripts/cloudflare-setup.sh. [required, set by
# scripts/cloudflare-setup.sh]
D1_DATABASE_ID=
# File with CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID for the deploy scripts. Never sent to
# the Worker.
CLOUDFLARE_ENV_FILE=.env.cloudflare
