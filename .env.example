# Copy to .env.production (prod) — Bun loads it automatically when NODE_ENV=production.
PORT=4380
HOST=127.0.0.1
PUBLIC_URL=https://kuakua.maxinsights.ai
DATA_DIR=./data
APP_TIMEZONE=Asia/Shanghai

CF_ACCESS_TEAM_DOMAIN=maxinsights.cloudflareaccess.com
# printed by scripts/cloudflare-setup.sh
CF_ACCESS_AUD=
ALLOWED_EMAIL_DOMAINS=maxinsights.ai
ADMIN_EMAILS=mushan@maxinsights.ai

LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_URL=https://open.larksuite.com
LARK_SYNC_INTERVAL_HOURS=6
# DM recipients on Lark (needs im:message:send_as_bot + bot capability)
LARK_NOTIFY=1
# optional: also post every thanks to this group chat
LARK_BROADCAST_CHAT_ID=

BONUS_MONTHLY_ALLOWANCE=100
BONUS_AMOUNTS=10,20,50

# Local development only (never in production):
# DEV_AUTH_EMAIL=you@maxinsights.ai
