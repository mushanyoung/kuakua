{
  "name": "kuakua",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "demo:seed": "wrangler d1 migrations apply kuakua --local && node scripts/seed-demo.ts",
    "build:web": "node scripts/build-web.ts",
    "build": "pnpm run build:web && wrangler deploy --dry-run --outdir .wrangler/build --minify",
    "doctor": "node scripts/config.ts doctor",
    "config": "node scripts/config.ts",
    "roster:push": "node scripts/push-roster.ts",
    "deploy": "./scripts/deploy.sh",
    "types": "wrangler types src/server/worker-configuration.d.ts --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/server && tsc --noEmit -p tests",
    "test:integration": "node scripts/test.ts integration",
    "test:avatars": "node --test tests/avatars.test.ts",
    "test:lark-chats": "node --test tests/lark-chats.test.ts",
    "format": "biome format --write .",
    "format:check": "biome format . --error-on-warnings",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome check --write . --error-on-warnings",
    "test:unit": "node scripts/test.ts unit",
    "test:e2e": "playwright test",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run test:integration && pnpm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@heroicons/react": "2.2.0",
    "canvas-confetti": "1.9.4",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.148.0"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.12.1",
    "pnpm": "12.15.0"
  }
}
