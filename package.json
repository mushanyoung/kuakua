{
  "name": "kuakua",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "demo:seed": "node scripts/seed-demo.ts",
    "build:web": "node scripts/build-web.ts",
    "build": "pnpm run build:web && DO_NOT_TRACK=1 CF_SEND_TELEMETRY=false WRANGLER_SEND_METRICS=false cf build --mode development",
    "doctor": "node scripts/config.ts doctor",
    "config": "node scripts/config.ts",
    "roster:push": "node scripts/push-roster.ts",
    "deploy": "./scripts/deploy.sh",
    "types": "DO_NOT_TRACK=1 CF_SEND_TELEMETRY=false WRANGLER_SEND_METRICS=false cf workers types --mode development",
    "typecheck": "pnpm run types && tsc --noEmit && tsc --noEmit -p src/server && tsc --noEmit -p tests",
    "test:integration": "node scripts/test.ts integration",
    "test:avatars": "node --test tests/avatars.test.ts",
    "test:lark-chats": "node --test tests/lark-chats.test.ts",
    "format": "biome format --write .",
    "format:check": "biome format . --error-on-warnings",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome check --write . --error-on-warnings",
    "test:unit": "node scripts/test.ts unit",
    "test:e2e": "playwright test",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run test:integration && pnpm run test:cli && pnpm run test:e2e",
    "test:cli": "node scripts/test.ts cli"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@heroicons/react": "2.2.0",
    "canvas-confetti": "1.9.4",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/config": "0.28.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.23",
    "esbuild": "0.28.1",
    "miniflare": "5.20261023.0-beta",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.12.1",
    "pnpm": "12.15.0"
  }
}
