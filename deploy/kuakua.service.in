# Template for scripts/deploy.sh, which fills in the @...@ values and installs the result
# as /etc/systemd/system/<SERVICE_NAME>.service. Don't install this file by hand.
[Unit]
Description=Kuakua 夸夸 (@PUBLIC_URL@)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@DIR@
Environment=NODE_ENV=production
EnvironmentFile=@DIR@/.env.production
ExecStart=@BUN@ src/server/index.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
