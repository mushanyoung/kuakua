{
  // The Worker (src/server) is checked on its own with Workers runtime types from
  // `cf workers types` (.cloudflare/types/index.d.ts). Its inferred Env imports the
  // Node-based config; Node types support that config and the enabled nodejs_compat flag.
  "compilerOptions": {
    "lib": ["ES2024"],
    "target": "ES2024",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../../.cloudflare/types/index.d.ts"]
}
